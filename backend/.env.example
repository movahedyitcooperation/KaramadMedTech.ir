DATABASE_URL=postgresql+asyncpg://karamad:karamad@localhost:5432/karamad_medtech
JWT_SECRET=change-me-to-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:3000

# --- customer OTP auth (Phase 5) -------------------------------------------
# console prints the OTP to this terminal — never block development on real
# SMS/SMTP credentials.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_TEMPLATE=
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@karamadmedtech.ir
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=120
OTP_MAX_REQUESTS_PER_CONTACT_PER_HOUR=5
OTP_MAX_REQUESTS_PER_IP_PER_HOUR=20
CUSTOMER_JWT_EXPIRE_DAYS=30

# --- checkout & payment (Phase 6) -------------------------------------------
# mock auto-approves every payment — never block development on real
# ZarinPal merchant credentials.
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:8000/api/v1/payments/callback

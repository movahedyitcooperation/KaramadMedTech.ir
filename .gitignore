# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Python / uv
.venv/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/

# env files — never commit real credentials
.env
.env.*
!.env.example

# runtime uploads
uploads/

# misc
.DS_Store
*.pem

# claude code — personal permission overrides, not shared with the team
.claude/settings.local.json

# secrets — never commit
GitHub repo PAT and URL.txt
*.local.md
ADMIN_CREDENTIALS.local.md
